# ============================================================
# Condensate Core — Environment Configuration
# Copy this file to .env and fill in your values.
#
# Fair LoCoMo runs: also apply benchmarks/docker-compose.bench.yml
# (sets RETRIEVE_BENCHMARK_MODE=1 and related knobs on condensate-core).
# Run `bash benchmarks/scripts/check_benchmark_mode.sh` before benchmarking.
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql://condensate:password@db:5432/condensate_db
# SQLAlchemy QueuePool (parallel clients / MCP bursts). Defaults: 30 + 50 overflow, 60s wait.
# SQLALCHEMY_POOL_SIZE=30
# SQLALCHEMY_MAX_OVERFLOW=50
# SQLALCHEMY_POOL_TIMEOUT=60
# SQLALCHEMY_POOL_RECYCLE=1800

# ------------------------------------------------------------
# Vector Store (Qdrant)
# QDRANT_URL takes precedence over QDRANT_HOST + QDRANT_PORT.
# Use QDRANT_URL for managed/cloud Qdrant; use HOST+PORT for
# docker-compose setups where the service name is the hostname.
# ------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# QDRANT_URL=http://qdrant:6333        # Override full URL (optional)
QDRANT_API_KEY=                        # Required for Qdrant Cloud

# ------------------------------------------------------------
# LLM Provider (OpenAI-compatible)
# Default: local Ollama. Set LLM_ENABLED=true to activate.
# ------------------------------------------------------------
LLM_ENABLED=false
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=phi3
# Max concurrent LLM requests (semaphore). Bench overlay uses 1.
# LLM_MAX_CONCURRENCY=4

# Cloud LLM example (uncomment to use OpenAI):
# LLM_ENABLED=true
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-openai-xxxx
# LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# NER Model (Hugging Face / ModernBERT)
# HF_TOKEN enables authenticated downloads and higher rate
# limits from the Hugging Face Hub. Strongly recommended to
# avoid cold-start failures on first boot.
# ------------------------------------------------------------
HF_TOKEN=                              # hf_xxxx (get from huggingface.co/settings/tokens)

# ------------------------------------------------------------
# GPU Acceleration
# The condensate-core container auto-detects NVIDIA GPUs.
# GLiNER (NER) uses CUDA via PyTorch; fastembed uses CUDA via
# ONNX Runtime.  Ollama has its own GPU reservation in
# docker-compose.yml.  Set CUDA_VISIBLE_DEVICES to restrict
# which GPUs are used (default: all).
# ------------------------------------------------------------
# CUDA_VISIBLE_DEVICES=0
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# HMAC secret used to sign Proof Envelopes — CHANGE IN PRODUCTION
CONDENSATE_SECRET=changeme_in_production

# Admin dashboard credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Public API rate limiting (src/server/observability.py)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------
# Application paths
# ------------------------------------------------------------
# APP_ROOT=/app                          # Root for data files (stopwords cache, etc.)
# CONFIG_CACHE_TTL_SECONDS=30            # TTL for cached llm_config.json / system_config.json

# ------------------------------------------------------------
# Memory Pipeline
# ------------------------------------------------------------
# Assertion review mode: "manual" (HITL queue) or "auto" (approve all)
REVIEW_MODE=manual

# Guardrail thresholds (0.0 = block nothing, 1.0 = block everything)
INSTRUCTION_BLOCK_THRESHOLD=0.5
SAFETY_BLOCK_THRESHOLD=0.7

# Fallback confidence for answer synthesis when Astrocyte plan has no threshold
# CONFIDENCE_THRESHOLD=0.8

# Episodes processed per condenser batch during ingest (bench overlay: 15)
# CONDENSE_BATCH_SIZE=40

# ------------------------------------------------------------
# Retrieval — MemoryRouter (src/retrieve/router.py)
# Set on condensate-core. Fair benchmark values are in
# benchmarks/docker-compose.bench.yml.
# ------------------------------------------------------------

# --- Benchmark / fair-run contract (REQUIRED for LoCoMo harness) ---
# When 1/true/yes: deterministic recall gate, no LLM refinement per query,
# raw context returned (no verifier stripping), multi-query expansion on.
# RETRIEVE_BENCHMARK_MODE=1

# --- Context assembly ---
# RETRIEVE_RERANK_TOP_N=16               # Final context item cap after rerank (fair: 35)
# RETRIEVE_MAX_CONTEXT_CHARS=28000     # Hard cap on assembled context string
# RETRIEVE_SKIP_RERANK=0                 # 1 = heuristic rerank only (fair: 1)

# --- Vector / assertion search limits ---
# RETRIEVE_VECTOR_LIMIT=20               # Max Qdrant hits merged (fair: 36)
# RETRIEVE_ASSERTION_LIMIT=25            # Max graph assertions per search (fair: 40)
# RETRIEVE_LIGHT_GRAPH_LIMIT=12          # Cap for light entity assertion fallback

# --- Source-turn hydration (dated raw dialog for temporal QA) ---
# RETRIEVE_SOURCE_TURN_HYDRATION=        # unset = on in benchmark mode, off otherwise
# RETRIEVE_SOURCE_TURN_MAX=12            # Max dia_ids to hydrate per retrieve

# --- Graph traversal (interactive / non-bench) ---
# RETRIEVE_BENCHMARK_SKIP_GRAPH=0        # 1 = skip graph in benchmark (fair: 1)
# RETRIEVE_BENCHMARK_GRAPH_STEPS=0       # Graph steps when skip_graph but multihop (fair: 0)
# RETRIEVE_BENCHMARK_MULTI_QUERY=1       # Extra embedding queries in benchmark mode

# --- Adversarial / false-premise filtering (query-only; no benchmark category hint) ---
# RETRIEVE_ADVERSARIAL_FILTER=1          # Prefer observations over raw dialog
# RETRIEVE_ENTITY_ALIGNMENT_FILTER=1     # Strip attribute assertions without entity provenance (counterfactual)
# RETRIEVE_SWAP_TRAP_FILTER=1          # Suppress trap leakage on narrow entity-swap traps only (not open-domain book/game Qs)
# RETRIEVE_ADVERSARIAL_RAW_LIMIT=6       # Max raw dialog lines when filtering (fair: 2)
# RETRIEVE_ADVERSARIAL_RAW_LIMIT_STRICT=0  # 0 = drop all raw dialog in aggressive mode

# --- Embedding device ---
# RETRIEVE_EMBED_CPU=0                   # 1 = force CPU for query embeddings (fair: 1)

# ------------------------------------------------------------
# Ingestion
# ------------------------------------------------------------
# Number of parallel workers for ingest_codebase.py
INGEST_WORKERS=8

# Directory where uploaded files are stored (relative to app root)
UPLOAD_DIR=uploads

# ------------------------------------------------------------
# SDK / Client (Python SDK CLI, ingest scripts, benchmark harness)
# ------------------------------------------------------------
CONDENSATE_URL=http://localhost:8000
CONDENSATE_API_KEY=sk-your-api-key-here

# ingest_codebase.py (falls back to API_URL if unset)
# CONDENSATE_API_URL=http://localhost:8000/mcp/tools/call
# API_URL=http://localhost:8000/mcp/tools/call
# API_KEY=                                 # Alias for CONDENSATE_API_KEY in ingest script

# ------------------------------------------------------------
# LoCoMo / benchmark harness (test-benchmarks container)
# See benchmarks/docker-compose.bench.yml for compose defaults.
# ------------------------------------------------------------
# CONDENSATE_SKIP_INGEST=0                 # 1 = skip re-ingest, retrieve only
# LOCOMO_BULK_CHUNK_SIZE=15                # Episodes per bulk ingest POST
# CONDENSATE_BULK_RETRIES=6
# CONDENSATE_RETRIEVE_RETRIES=24
# CONDENSATE_QA_DELAY_S=0                  # Pause between retrieve calls (fair: 0.25)
# CONDENSATE_HTTP_READ_TIMEOUT=900         # httpx read timeout (seconds)
# CONDENSATE_CORE_WAIT_S=600               # Reserved; condensation poll default is 120s in backend
# CONDENSATE_ANSWER_FEEDBACK=0             # 1 = POST /api/v1/memory/feedback after each QA grade
# LOCOMO_DATA_PATH=benchmarks/data/locomo10.json

# LLM-as-judge for optional grading (benchmarks/metrics/judge.py)
# OPENAI_API_KEY=

# Integration tests (docker-compose.test.yml)
# API_BASE_URL=http://condensate-core:8000

# ------------------------------------------------------------
# Data Migration (optional — bootstrap from LocalMem/old Qdrant)
# ------------------------------------------------------------
# LOCALMEMCP_PATH=/app/localmemcp_data
# OLD_QDRANT_HOST=host.docker.internal
# OLD_QDRANT_PORT=6333

# ------------------------------------------------------------
# Synapse Engine
# ------------------------------------------------------------
SYNAPSE_ENGINE_ENABLED=true
SYNAPSE_LEARNING_RATE=0.08
SYNAPSE_DECAY_RATE=0.995
SYNAPSE_PRUNE_THRESHOLD=0.05
SYNAPSE_CONSOLIDATION_THRESHOLD=0.75
SYNAPSE_DECAY_INTERVAL_HOURS=24

# ------------------------------------------------------------
# Ollama (condensate-ollama service — docker-compose / bench overlay)
# ------------------------------------------------------------
# OLLAMA_MAX_LOADED_MODELS=1
# OLLAMA_NUM_PARALLEL=1

# ------------------------------------------------------------
# Developer / CI only
# ------------------------------------------------------------
# RUN_GLINER_TESTS=false                 # Set true to run real GLiNER integration tests
# PYTHONPATH=/app
